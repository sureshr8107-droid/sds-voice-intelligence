# SDS Voice Intelligence - Local AI Service Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# FFmpeg Executable Path (Relative to ai-service or absolute)
FFMPEG_EXECUTABLE_PATH=../tools/ffmpeg/bin/ffmpeg.exe

# faster-whisper STT Configuration
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# Audio Processing and Upload Limits
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_AUDIO_DURATION_SECONDS=120.0
AUDIO_PROCESSING_TIMEOUT_SECONDS=30.0

# Audio Working Directories
AUDIO_TMP_DIR=./tmp/audio
AUDIO_OUTPUT_DIR=./tmp/output

# Ollama LLM Configuration (Phase 6.4)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=15
OLLAMA_TEMPERATURE=0.1
MAX_TRANSCRIPTION_LENGTH=2000
INTENT_MAX_CONCURRENT_REQUESTS=2
INTENT_CONFIDENCE_THRESHOLD=0.6

# Piper TTS Configuration (Phase 6.5)
PIPER_EXECUTABLE_PATH=../tools/piper/piper.exe
PIPER_MODEL_PATH=../tools/piper/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=../tools/piper/en_US-lessac-medium.onnx.json
PIPER_TIMEOUT_SECONDS=15.0
MAX_TTS_TEXT_LENGTH=1000
DEFAULT_TTS_SPEED=1.0
MIN_TTS_SPEED=0.5
MAX_TTS_SPEED=2.0
